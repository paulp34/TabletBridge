<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EFEFEF"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="…"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start bridge" />

        <Button
            android:id="@+id/btnScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share tablet screen (optional)" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop bridge" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable input control (Accessibility)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Start the bridge above.\n2. On the PC, connect the USB cable and run:\n\n    adb forward tcp:8787 tcp:8787\n\n3. Open http://127.0.0.1:8787 in the PC browser.\n4. Enter the passcode shown above when asked.\n5. For remote taps/swipes, enable the accessibility service."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
